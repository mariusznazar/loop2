{
  "name": "loop2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "node scripts/build.mjs --check",
    "build": "node scripts/build.mjs",
    "start": "node dist/server/main.js",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test tests/http.test.mjs tests/startup.test.mjs \"tests/sim/*.test.mjs\" \"tests/view/*.test.mjs\" && python -B .the-way/gate/run_tests.py && python -B .the-way/elements/common/foundation_check.py"
  },
  "dependencies": {
    "express": "5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "npm": "12.2.1",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-compiler": "npm:typescript@7.0.2",
    "typescript-eslint": "8.71.2"
  },
  "overrides": {
    "@typescript/old": "npm:typescript@6.0.2"
  }
}
