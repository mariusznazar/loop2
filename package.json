{
  "name": "loop2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "node scripts/build.mjs --check",
    "build": "node scripts/build.mjs",
    "kitchen-sink": "node scripts/kitchen-sink.mjs",
    "start": "node dist/server/main.js",
    "dev": "npm run build && npm start",
    "local": "npm run build && node scripts/local-start.mjs",
    "local:stop": "node scripts/local-start.mjs --stop",
    "test": "python -B scripts/test.py"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "nodemailer": "10.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/tap-runner": "10.0.0",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "24.19.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "npm": "12.2.1",
    "prettier": "3.9.10",
    "smtp-server": "3.21.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-compiler": "npm:typescript@7.0.2",
    "typescript-eslint": "8.71.2"
  },
  "overrides": {
    "@typescript/old": "npm:typescript@6.0.2",
    "@stryker-mutator/core": {
      "typed-rest-client": {
        "qs": "6.16.1"
      }
    }
  }
}
