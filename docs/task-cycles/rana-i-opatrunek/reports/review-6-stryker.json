{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "tap",
  "plugins": [
    "@stryker-mutator/tap-runner"
  ],
  "checkers": [],
  "mutate": [
    "src/browser/sim/saved-game.ts:86-96",
    "src/browser/sim/saved-game.ts:403-445",
    "src/browser/sim/saved-game.ts:750-785"
  ],
  "buildCommand": "node ../../node_modules/typescript-compiler/bin/tsc -p tsconfig.browser.json",
  "concurrency": 4,
  "ignorePatterns": [
    ".runs",
    ".the-way",
    "dist"
  ],
  "tempDirName": ".stryker-tmp",
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "review6-mutation.json"
  },
  "tap": {
    "testFiles": [
      "tests/sim/saved-game.test.mjs",
      "tests/sim/previous-programs.test.mjs"
    ]
  }
}