{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "tap",
  "plugins": ["@stryker-mutator/tap-runner"],
  "checkers": [],
  "mutate": [
    "src/browser/sim/combat.ts:46-93",
    "src/browser/sim/combat.ts:165-185",
    "src/browser/sim/program.ts:507-580",
    "src/browser/sim/saved-game.ts:764-770"
  ],
  "buildCommand": "node ../../node_modules/typescript-compiler/bin/tsc -p tsconfig.browser.json",
  "concurrency": 4,
  "ignorePatterns": [".runs", ".the-way", "dist", "probe-review-4.mjs", "probe-review-4.out.txt"],
  "tempDirName": ".stryker-tmp",
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "stryker-review-4.json" },
  "tap": {
    "testFiles": [
      "tests/sim/pressure.test.mjs",
      "tests/sim/combat.test.mjs",
      "tests/sim/encounters.test.mjs",
      "tests/sim/gear-combat.test.mjs",
      "tests/sim/gear-combat-wear.test.mjs",
      "tests/sim/rule-signs.test.mjs",
      "tests/sim/saved-game.test.mjs",
      "tests/sim/gear-wear.test.mjs",
      "tests/sim/tending.test.mjs"
    ]
  }
}
