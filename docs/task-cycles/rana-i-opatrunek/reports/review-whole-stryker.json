{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "tap",
  "plugins": ["@stryker-mutator/tap-runner"],
  "checkers": [],
  "mutate": [
    "src/browser/sim/skills.ts:96-176",
    "src/browser/sim/understanding.ts:53-135",
    "src/browser/sim/understanding.ts:223-250",
    "src/browser/sim/understanding.ts:403-420",
    "src/browser/sim/body.ts:120-128",
    "src/browser/sim/run.ts:580-588",
    "src/browser/sim/combat.ts:46-95",
    "src/browser/sim/combat.ts:160-185"
  ],
  "buildCommand": "node ../../node_modules/typescript-compiler/bin/tsc -p tsconfig.browser.json",
  "concurrency": 4,
  "ignorePatterns": [".runs", ".the-way", "dist", "out", "probe-health.mjs", "stryker-review-whole.json"],
  "tempDirName": ".stryker-tmp",
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "out/stryker-review-whole.json" },
  "tap": {
    "testFiles": [
      "tests/sim/tending.test.mjs",
      "tests/sim/pressure.test.mjs",
      "tests/sim/craft-and-tend.test.mjs",
      "tests/sim/body.test.mjs",
      "tests/sim/skills.test.mjs",
      "tests/sim/repertoire.test.mjs",
      "tests/sim/discovery.test.mjs",
      "tests/sim/action-targets.test.mjs",
      "tests/sim/data.test.mjs",
      "tests/sim/combat.test.mjs",
      "tests/sim/gear-combat.test.mjs",
      "tests/sim/rule-signs.test.mjs"
    ]
  }
}
