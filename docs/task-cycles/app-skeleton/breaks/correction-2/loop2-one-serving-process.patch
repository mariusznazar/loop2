 // so the app serves the same files whatever the working directory is.
 const publicDirectory = fileURLToPath(new URL('../public/', import.meta.url));
 
-export function createApp(): Express {
-  const app = express();
+export const apiPort = 3001;
 
-  // No API route exists yet: every /api, /api/ and /api/... request gets a JSON 404,
-  // never the game's page.
+// Runs in its own process: answers /api requests only.
+export function createApiApp(): Express {
+  const app = express();
   app.use('/api', (_request: Request, response: Response) => {
     response.status(404).json({ error: 'Not found' });
   });
+  return app;
+}
+
+// Serves the game and forwards /api requests to the API process.
+export function createApp(): Express {
+  const app = express();
+
+  app.use('/api', async (request: Request, response: Response) => {
+    try {
+      const upstream = await fetch(`http://127.0.0.1:${apiPort}${request.originalUrl}`);
+      response
+        .status(upstream.status)
+        .type(upstream.headers.get('content-type') ?? 'application/json')
+        .send(await upstream.text());
+    } catch {
+      response.status(502).json({ error: 'API process unavailable' });
+    }
+  });
 
   app.use(express.static(publicDirectory));
 
