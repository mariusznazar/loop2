{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "strict": true,
    "noEmitOnError": true,
    "jsx": "react-jsx",
    "rootDir": "src/browser",
    "outDir": "dist/browser"
  },
  "include": ["src/browser/**/*.ts", "src/browser/**/*.tsx"],
  "exclude": ["src/browser/kitchen-sink/**"]
}
